<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RestoreAdditionalProjectSources>
			https://api.nuget.org/v3/index.json;
			https://nuget.bepinex.dev/v3/index.json;
			https://nuget.samboy.dev/v3/index.json
		</RestoreAdditionalProjectSources>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		
		<EnvFileContent Condition="Exists('$(MSBuildProjectDirectory)\.env')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.env'))</EnvFileContent>
		<STEAM_PATH>$([System.Text.RegularExpressions.Regex]::Match($(EnvFileContent), `(?m)^STEAM_PATH\s*=\s*["']?([^"'\r\n]+)["']?`).Groups[1].Value)</STEAM_PATH>
		<STEAM_PATH Condition="'$(STEAM_PATH)' == ''">C:\Program Files (x86)\Steam</STEAM_PATH>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.0" />
		<PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Include="Krafs.Publicizer" Version="2.3.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" />
		<Reference Include="Assembly-CSharp">
			<HintPath>$(STEAM_PATH)\steamapps\common\Unfair Flips\Unfair Flips_Data\Managed\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Publicize Include="Assembly-CSharp"/>
		<Reference Include="nl.jeffreylanters.tweens">
		  <HintPath>$(STEAM_PATH)\steamapps\common\Unfair Flips\Unfair Flips_Data\Managed\nl.jeffreylanters.tweens.dll</HintPath>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
		  <HintPath>$(STEAM_PATH)\steamapps\common\Unfair Flips\Unfair Flips_Data\Managed\Unity.TextMeshPro.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.UI">
		  <HintPath>$(STEAM_PATH)\steamapps\common\Unfair Flips\Unfair Flips_Data\Managed\UnityEngine.UI.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="BreakInfinity.cs\BreakInfinity.Benchmarks\**" />
	  <Compile Remove="BreakInfinity.cs\BreakInfinity.Tests\**" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Remove="BreakInfinity.cs\BreakInfinity.Benchmarks\**" />
	  <EmbeddedResource Remove="BreakInfinity.cs\BreakInfinity.Tests\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="BreakInfinity.cs\BreakInfinity.Benchmarks\**" />
	  <None Remove="BreakInfinity.cs\BreakInfinity.Tests\**" />
	</ItemGroup>
	
	<ItemGroup>
		<PluginFiles Include="$(ProjectDir)Package\Unfair_Flips_Archipelago\**\*" />
	</ItemGroup>
	
	<ItemGroup>
		<UFDependencies Include="$(NuGetPackageRoot)archipelago.multiclient.net\6.7.0\lib\netstandard2.0\Archipelago.MultiClient.Net.dll" />
		<UFDependencies Include="$(NuGetPackageRoot)newtonsoft.json\**\lib\netstandard2.0\Newtonsoft.Json.dll" />
	</ItemGroup>
	
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<MakeDir Directories="$(ProjectDir)Package\Unfair_Flips_Archipelago" />
		<MakeDir Directories="$(ProjectDir)output" />

		<Copy
			SourceFiles="$(TargetPath)"
			DestinationFolder="$(ProjectDir)Package\Unfair_Flips_Archipelago"
			OverwriteReadOnlyFiles="true" 
		/>

		<Copy
			SourceFiles="@(UFDependencies)"
			DestinationFolder="$(ProjectDir)Package\Unfair_Flips_Archipelago"
			OverwriteReadOnlyFiles="true"
		/>

		<Copy
			SourceFiles="@(PluginFiles)"
			DestinationFolder="$(STEAM_PATH)\steamapps\common\Unfair Flips\BepInEx\plugins\UnfairFlipsAPMod"
			OverwriteReadOnlyFiles="true" 
		/>

		<Exec Command="powershell -Command &quot;Compress-Archive -Path '$(ProjectDir)Package\*' -DestinationPath '$(ProjectDir)\output\Unfair_Flips_Archipelago_TS.zip' -Force&quot;" />
		<Exec Command="powershell -Command &quot;Compress-Archive -Path '$(ProjectDir)Package\Unfair_Flips_Archipelago\*' -DestinationPath '$(ProjectDir)output\UnfairFlipsAPMod.zip' -Force&quot;" />
	</Target>
</Project>